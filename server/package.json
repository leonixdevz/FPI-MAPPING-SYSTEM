{
  "name": "fpi-campus-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Express REST API + PostGIS backend for the FPI campus mapping system",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:setup": "node --env-file-if-exists=.env scripts/migrate.js && node --env-file-if-exists=.env scripts/seed.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
