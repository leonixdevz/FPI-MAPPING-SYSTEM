# ────────────────────────────────────────────────────────────────
# FPI Campus Mapping System — environment variables
#
# Copy to `.env` at the repository root and adjust, or run the API
# from `server/` with its own `server/.env`. Every variable has a
# sensible default (matching docker-compose.yml), so this file is
# optional for local development.
# ────────────────────────────────────────────────────────────────

# API server
PORT=4000

# PostGIS connection string (as configured in docker-compose.yml)
DATABASE_URL=postgres://fpi:fpi_secret@localhost:5432/fpi_campus

# Admin dashboard credentials (CHANGE THESE for anything public)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_TTL_MS=43200000
