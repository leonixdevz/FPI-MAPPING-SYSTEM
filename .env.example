# Data backend selector
# - "local": in-memory + localStorage (default; no Supabase needed)
# - "supabase": real Supabase project (Phase K — not yet implemented)
VITE_DATA_BACKEND=local

# Demo admin credentials for the local backend ONLY.
# These are checked only by the local auth adapter; the real Supabase
# adapter (Phase K) will replace them with Supabase Auth.
# Override in your own .env (which is gitignored) for the defense demo.
VITE_DEMO_ADMIN_EMAIL=admin@school.local
VITE_DEMO_ADMIN_PASSWORD=admin123

# Supabase (Phase K — leave blank for now)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
