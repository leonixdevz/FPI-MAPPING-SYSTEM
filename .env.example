# Data backend selector
# - "local": in-memory + localStorage (default; no Supabase needed)
# - "supabase": real Supabase project — see supabase/migrations + README
VITE_DATA_BACKEND=local

# Demo admin credentials for the local backend ONLY (checked by the local
# auth adapter). Override in your own .env (which is gitignored) for the
# defense demo.
VITE_DEMO_ADMIN_EMAIL=admin@school.local
VITE_DEMO_ADMIN_PASSWORD=admin123

# Supabase backend — set these and VITE_DATA_BACKEND=supabase to use it.
# The anon key is safe to expose; it is constrained by Row Level Security.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
